# Copy into the member repo, replace the COPY lines and CMD with the
# server's own layout, keep everything else.
FROM python:3.12-slim

# git is needed for the commit-pinned beta-mcp-core dependency.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- server-specific payload ---
COPY lib/ lib/
COPY mcp_server.py .
# -------------------------------

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

USER appuser
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["python", "mcp_server.py", "--remote"]
